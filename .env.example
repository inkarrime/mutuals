# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.
DB_URL=jdbc:postgresql://localhost:5433/mutuals
DB_USERNAME=mutuals
DB_PASSWORD=mutuals

# Minimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
QR_SECRET=replace-with-another-long-random-secret-32-chars

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
FRONTEND_URL=http://localhost:5173

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=Mutuals <no-reply@mutuals.app>
MAIL_ENABLED=true

# log | fcm
PUSH_PROVIDER=log
FIREBASE_CREDENTIALS_PATH=

# local | s3
STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_REGION=us-east-1

ADMIN_EMAIL=admin@mutuals.app
ADMIN_PASSWORD=Admin!2026pass
