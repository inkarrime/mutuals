# Copy to ~/mutuals.env on the EC2 instance. Never commit the real file.
DB_URL=jdbc:postgresql://<rds-endpoint>.rds.amazonaws.com:5432/mutuals?sslmode=require
DB_USERNAME=mutuals
DB_PASSWORD=<rds-master-password>

# Generate each one with: openssl rand -base64 48
JWT_SECRET=<random-secret-at-least-32-chars>
QR_SECRET=<another-random-secret-at-least-32-chars>
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Gmail SMTP (use an App Password) or any other SMTP provider. Set MAIL_ENABLED=false to skip emails.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<your-gmail-address>
MAIL_PASSWORD=<gmail-app-password>
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=Mutuals <your-gmail-address>
MAIL_ENABLED=true

PUSH_PROVIDER=log
STORAGE_PROVIDER=local

ADMIN_EMAIL=admin@mutuals.app
ADMIN_PASSWORD=<strong-admin-password>
